library(tidyverse)
ces <- read_csv("https://raw.githubusercontent.com/dwillis/jour405/refs/heads/main/data/wmata_daily.csv")
wmata_zscores <- wmata |>
mutate(
mean_rail = mean(rail),
sd_rail = sd(rail),
rail_zscore = (rail - mean_rail) / sd_rail
)
wmata_zscores <- wmata |> ces
wmata_zscores <- wmata |>
mutate(
mean_rail = mean(rail),
sd_rail = sd(rail),
rail_zscore = (rail - mean_rail) / sd_rail
)
wmata_zscores <- wmata_zcores |>
mutate(
mean_rail = mean(rail),
sd_rail = sd(rail),
rail_zscore = (rail - mean_rail) / sd_rail
)
wmata_zscores <- ces |>
mutate(
mean_rail = mean(rail),
sd_rail = sd(rail),
rail_zscore = (rail - mean_rail) / sd_rail
)
wmata_zscores <- wmata_zscores |>
group_by(weekday) |>
mutate(
weekday_mean = mean(rail),
weekday_sd = sd(rail),
weekday_zscore = (rail - weekday_mean) / weekday_sd
) |>
ungroup()
unusual_rail <- wmata_zscores |>
filter(abs(rail_zscore) > 2) |>
arrange(desc(abs(rail_zscore)))
unusual_rail
View(unusual_rail)
View(unusual_rail)
View(unusual_rail)
View(unusual_rail)
library(tidyverse)
ces <- read_csv("https://raw.githubusercontent.com/dwillis/jour405/refs/heads/main/data/md_car_thefts.csv")
md_car_thefts <- read_csv("https://raw.githubusercontent.com/dwillis/jour405/refs/heads/main/data/md_car_thefts.csv")
md_car_thefts <- md_car_thefts |>
mutate(theft_rate = thefts_2024/population * 10000,
pct_change = (thefts_2024 - thefts_2023)/thefts_2023 * 100)
md_car_thefts |>
arrange(desc(theft_rate)) |>
head(5)
View(md_car_thefts)
View(md_car_thefts)
unusual_weekday <- wmata_zscores |>
filter(abs(weekday_zscore) > 2) |>
arrange(desc(abs(weekday_zscore)))
unusual_weekday
nrow(unusual_rail)
