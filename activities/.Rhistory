library(tidyverse)
ces <- read_csv("https://raw.githubusercontent.com/dwillis/jour405/refs/heads/main/data/montco_inspections.csv")
compliance_stats|>
summarize(
mean_compliance = mean(SALARY, na.rm = TRUE),
median_compliance = median(SALARY, na.rm = TRUE),
sd_compliance = sd(SALARY, na.rm = TRUE),
min_compliance = min(SALARY, na.rm = TRUE),
max_compliance= max(SALARY, na.rm = TRUE)
)
compliance_stats <- ces |>
summarize(
mean_score = mean(compliance_score),
sd_score   = sd(compliance_score),
min_score  = min(compliance_score),
max_score  = max(compliance_score)
)
View(compliance_stats)
ggplot(complainace_stats, aes(x = COMPLIANCE)) +
geom_histogram() +
geom_vline(xintercept = mean(compliance_stats$COMPLIANCE), color = "red") +
geom_vline(xintercept = mean(compliance_stats$COMPLIANCE) - sd(compliance_stats$COMPLIANCE), color = "blue") +
geom_vline(xintercept = mean(compliance_stats$COMPLIANCE) + sd(compliance_stats$COMPLIANCE), color = "blue")
ces |>
ggplot() +
geom_histogram(aes(x = compliance_score), binwidth = 2) +
geom_vline(aes(xintercept = mean(compliance_score)), color = "red", linetype = "dashed", linewidth = 1) +
labs(title =  "Montgomery County restaurant inspections",
x = "Compliance Score",
y = "Number of Inspections")
View(compliance_stats)
